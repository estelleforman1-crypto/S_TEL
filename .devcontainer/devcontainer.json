{
  "name": "Jewelry Store",
  // Ready-made image (PHP 8.3, Node, git, curl). No custom build step that could fail.
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Shop", "onAutoForward": "openPreview" }
  },
  // Runs once when the codespace is created. Each step is allowed to fail on its own
  // without stopping the shop build: extra PHP extensions, then the shop, then the test browser.
  "postCreateCommand": "bash scripts/codespace-setup.sh",
  // Runs every time the codespace starts: the web server, in the background.
  "postStartCommand": "nohup bash -c 'npm start > /tmp/jewelry-server.log 2>&1 &'",
  "postAttachCommand": "bash scripts/dev-info.sh",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  }
}
