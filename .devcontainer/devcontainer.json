{
  "name": "Jewelry Store",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Shop", "onAutoForward": "openPreview" }
  },
  "containerEnv": {
    "PHP_CLI_SERVER_WORKERS": "4"
  },
  // Runs once, when the codespace is created. The shop is built first; the test browser
  // is optional and cannot block it.
  "postCreateCommand": "npm install && npm start -- --build-only; npx playwright install --with-deps chromium || echo 'Optional test browser not installed. Later: npm run test:browser-install'",
  // Runs every time the codespace starts: the web server, in the background.
  "postStartCommand": "nohup bash -c 'npm start > /tmp/jewelry-server.log 2>&1 &'",
  "postAttachCommand": "bash scripts/dev-info.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client"]
    }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" }
}
