# Copy to .env for local development. Safe example values only. Never commit .env.
SITE_URL=http://localhost:8080
WP_DIR=.dev/wordpress
# sqlite (default, no database server) or mysql
DB_ENGINE=sqlite
DB_NAME=jewelry_dev
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-local-only
ADMIN_EMAIL=dev@example.test
# Pinned, tested versions. See docs/commerce-validation.md.
WP_VERSION=7.1.4
WC_VERSION=11.3.0
SQLITE_PLUGIN_VERSION=3.1.3
